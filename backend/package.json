{
  "name": "backend",
  "version": "0.1.1",
  "private": true,
  "description": "Backend для CRM системы грантов",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/app.js",
    "export-worker": "ts-node src/jobs/exportWorker.ts",
    "clean:logs": "node -e \"const fs=require('fs');const path=require('path');['logs','*.log'].forEach(p=>{try{if(fs.existsSync(p)){if(fs.statSync(p).isDirectory()){fs.rmSync(p,{recursive:true,force:true})}else{fs.unlinkSync(p)}}console.log('✓ Очищено:',p)}catch(e){console.error('✗ Ошибка:',p,e.message)}})\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "archiver": "^5.3.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.16.0",
    "nodemon": "^3.0.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.0"
  }
}
